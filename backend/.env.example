SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Choose either DATABASE_URL or DB_ENGINE/DB_*.
DATABASE_URL=
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SAP_BASE_URL=https://sap-host.example:50000/b1s/v2
SAP_COMPANY_DB=replace-with-company-db
SAP_USERNAME=replace-with-sap-username
SAP_PASSWORD=replace-with-sap-password
# Secure default. Custom CA paths may be absolute or relative to backend/.
SAP_VERIFY_SSL=True
SAP_CA_BUNDLE=
# Internal development only: DEBUG=True and SAP_VERIFY_SSL=False (no CA bundle).

REDIS_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=receipt_from_production
CACHE_DEFAULT_TIMEOUT=300
CACHE_TIMEOUT_SAP_ITEM_GROUPS=3600
CACHE_TIMEOUT_SAP_QUOTATION_METADATA=3600
CACHE_TIMEOUT_SAP_ITEMS=900
CACHE_TIMEOUT_SAP_FARMS=1800
CACHE_TIMEOUT_SAP_CONTRACTORS=1800
CACHE_TIMEOUT_BATCH_UDF_METADATA=1800
CACHE_TIMEOUT_QUALITY_CATEGORIES=300
CACHE_TIMEOUT_INSPECTION_STAGES=300
CACHE_TIMEOUT_QUALITY_CRITERIA=300
CACHE_TIMEOUT_INSPECTION_QUALITY_CRITERIA=300
CACHE_TIMEOUT_ITEM_QUALITY_CRITERIA=300
REDIS_SOCKET_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1

TRANSFER_INTERMEDIATE_WAREHOUSES=
TRANSFER_FRIDGE_WAREHOUSES=

# Scale Agent Deployment (URL reachable from the Scale Agent PC, e.g. http://192.168.1.10:8000 or http://127.0.0.1:8000)
SCALE_AGENT_SERVER_URL=http://127.0.0.1:8000
# Shared credential used only by the Scale Agent for weight ingestion.
# Generate a long random value and configure the same value on the Agent.
SCALE_AGENT_AUTH_TOKEN=replace-with-a-long-random-scale-agent-token
# Defaults to scale_agent/dist/recovery-release/ScaleAgent.exe in this repository.
# Override only with the absolute path to the approved release on the ERP server.
# SCALE_AGENT_EXE_PATH=
