+.sales-document-toolbar__filters { display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }
+.sales-document-toolbar__search { flex: 1 1 240px; max-width: 360px; min-width: 0; }
+.sales-document-quantities { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 88px), 1fr)); gap: 12px; padding: 12px; border-radius: var(--radius-md); background: var(--bg-muted); text-align: center; }
+.sales-document-quantities > div { min-width: 0; }
+@media (max-width: 600px) {
+  .sales-document-toolbar__search { max-width: none; flex-basis: 100%; }
+}
 
