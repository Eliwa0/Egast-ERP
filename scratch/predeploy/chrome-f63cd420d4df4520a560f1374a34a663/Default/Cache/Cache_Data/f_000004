ransition, .page-shell, .quality-wizard, .card-panel {\n    display: block !important;\n    width: 100% !important;\n    height: auto !important;\n    min-height: 0 !important;\n    max-height: none !important;\n    overflow: visible !important;\n    position: static !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    box-shadow: none !important;\n    border: none !important;\n    background: transparent !important;\n  }\n\n  /* Hide screen-only components completely from the print flow */\n  .app-toolbar,\n  .theme-fab,\n  .wizard-stepbar-wrap,\n  .quality-print-actions,\n  .no-print {\n    display: none !important;\n  }\n\n  /* Format printable report page container */\n  .print-layout-container {\n    display: block !important;\n    width: 100% !important;\n    position: relative !important;\n    visibility: visible !important;\n    direction: rtl !important;\n    background: white !important;\n    color: black !important;\n    padding: 0 !important;\n    margin: 0 !important;\n  }\n\n  .print-layout-container * {\n    visibility: visible !important;\n  }\n\n  .excel-matrix-table {\n    width: 100% !important;\n    border-collapse: collapse !important;\n    border: 1.5px solid black !important;\n    margin-bottom: 20px !important;\n  }\n\n  .excel-matrix-table th {\n    background-color: #cbd5e1 !important;\n    color: black !important;\n    border: 1.5px solid black !important;\n    font-weight: 800 !important;\n    padding: 6px !important;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n\n  .excel-matrix-table td {\n    background-color: white !important;\n    color: black !important;\n    border: 1px solid black !important;\n    padding: 6px !important;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n\n  .excel-matrix-table tr.totals-row td {\n    background-color: #cbd5e1 !important;\n    border-top: 1.5px solid black !important;\n    border-bottom: 4px double black !important;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n\n  /* Avoid page breaks inside key components to prevent clipping */\n  .print-header,\n  .print-metadata-grid,\n  .excel-matrix-table tr,\n  .print-signatures,\n  .report-footer-brand {\n    page-break-inside: avoid !important;\n    break-inside: avoid !important;\n  }\n}\r\n/* Quality Review Page Table Styles */\r\n.qrev-grid-scroll {\n  max-height: calc(100vh - 290px);\n}\r\n.qrev-table {\n  width: 100%;\n  min-width: 2260px;\n  border-collapse: collapse;\n  font-size: 12px;\n  table-layout: auto;\n}\r\n.qrev-table th,\n.qrev-table td {\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n  text-align: center;\n  vertical-align: middle;\n  line-height: 1.35 !important;\n}\r\n.qrev-table th {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  background: var(--bg-muted);\n  color: var(--text-muted);\n  font-size: 11px !important;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\r\n.qrev-table td {\n  color: var(--text);\n  background: var(--bg-elevated);\n  font-size: 12px !important;\n}\r\n.qrev-table td span {\n  font-size: 12px !important;\n}\r\n.qrev-table .qrev-mono {\n  font-size: 12px !important;\n  white-space: nowrap;\n}\r\n.qrev-table .qrev-decision {\n  max-width: none;\n  min-width: max-content;\n  font-size: 11px !important;\n  line-height: 1.25 !important;\n  white-space: nowrap;\n}\r\n.qrev-table .rr-status-badge {\n  font-size: 11px !important;\n  line-height: 1.25 !important;\n}\r\n.qrev-table .qrev-actions {\n  justify-content: center;\n  min-width: 316px;\n}\r\n.qrev-table .qrev-icon-btn {\n  flex: 0 0 38px;\n  width: 38px;\n  height: 38px;\n  font-size: 16px !important;\n  line-height: 1 !important;\n}\r\n.qrev-table th:nth-child(1),\n.qrev-table td:nth-child(1) { min-width: 56px; }\r\n.qrev-table th:nth-child(2),\n.qrev-table td:nth-child(2) {\n  min-width: 120px;\n  white-space: nowrap;\n}\r\n.qrev-table th:nth-child(3),\n.qrev-table td:nth-child(3) {\n  min-width: 190px;\n  white-space: nowrap;\n}\r\n.qrev-table th:nth-child(4),\n.qrev-table td:nth-child(4) {\n  min-width: 320px;\n  text-align: start;\n  white-space: normal;\n  overflow-wrap: break-word;\n}\r\n.qrev-table th:nth-child(5),\n.qrev-table td:nth-child(5) {\n  min-width: 140px;\n  white-space: nowrap;\n}\r\n.qrev-table th:nth-child(6),\n.qrev-table td:nth-child(6) {\n  min-width: 220px;\n  text-align: start;\n  white-space: normal;\n  overflow-wrap: break-word;\n}\r\n.qrev-table th:nth-child(7),\n.qrev-table td:nth-child(7) {\n  min-width: 240px;\n  text-align: start;\n  white-space: normal;\n  overflow-wrap: break-word;\n}\r\n.qrev-table th:nth-child(8),\n.qrev-table td:nth-child(8) {\n  min-width: 140px;\n  white-space: nowrap;\n}\r\n.qrev-table th:nth-child(9),\n.qrev-table td:nth-child(9) {\n  min-width: 160px;\n  text-align: start;\n}\r\n.qrev-table th:nth-child(10),\n.qrev-table td:nth-child(10) {\n  min-width: 180px;\n  white-space: nowrap;\n}\r\n.qrev-table th:nth-child(11),\n.qrev-table td:nth-child(11) {\n  min-width: 130px;\n  white-space: nowrap;\n}\r\n.qrev-table th:nth-child(12),\n.qrev-table td:nth-child(12) {\n  min-width: 340px;\n  width: auto;\n  max-width: none;\n  white-space: nowrap;\n}\r\n.qrev-table tbody tr:nth-child(even) td {\n  background: var(--bg-soft);\n}\r\n.qrev-table tbody tr:hover td {\n  background: var(--surface-elevated) !important;\n  filter: brightness(0.97);\n}\r\n[data-theme=\"dark\"] .qrev-table tbody tr:hover td {\n  filter: brightness(1.03);\n}\r\n@media (max-width: 1100px) {\n  .qrev-page .rr-filter-bar,\n  [dir='rtl'] .qrev-page .rr-filter-bar {\n    flex-wrap: wrap;\n  }\n\n  .qrev-filter-field--status,\n  .qrev-filter-field--product,\n  .qrev-filter-field--truck,\n  .qrev-filter-field--contractor,\n  .qrev-filter-field--farm,\n  .qrev-filter-field--inspector,\n  .qrev-filter-field--date-from,\n  .qrev-filter-field--date-to {\n    flex: 1 1 calc(33.333% - 10px);\n  }\n}\r\n@media (max-width: 780px) {\n  .qrev-page .rr-filter-bar > label,\n  .qrev-page .rr-filter-status,\n  .qrev-page .rr-filter-clear-btn {\n    flex: 1 1 100%;\n    width: 100%;\n    min-width: 0;\n    max-width: none;\n  }\n\n  .qrev-filter-field--date .rr-filter-input {\n    max-width: none;\n  }\n}\r\n@media (max-width: 640px) {\n  .qrev-page .rr-header-first-btn {\n    margin-inline-start: 0;\n  }\n}\r\n/* Percentage bar list styles matching form/ */\r\n.defect-categories-percentage-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 20px;\n  margin-bottom: 24px;\n}\r\n.defect-percentage-item {\n  margin-bottom: 14px;\n}\r\n.pct-info {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n  font-weight: 700;\n  margin-bottom: 4px;\n}\r\n.pct-bar-bg {\n  height: 8px;\n  background-color: var(--border, #e2e8f0);\n  border-radius: var(--radius-sm, 4px);\n  overflow: hidden;\n}\r\n.pct-bar-fill {\n  height: 100%;\n  width: 0;\n  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n}\r\n.pct-bar-fill.bar-pest { background-color: var(--color-success, #16a34a); }\r\n.pct-bar-fill.bar-mechanical { background-color: var(--color-warning, #d97706); }\r\n.pct-bar-fill.bar-other { background-color: var(--text-muted, #64748b); }\r\n/* Approved Print & A4 Sheet Styles */\r\n.a4-print-sheet {\n  max-width: 820px;\n  min-height: 297mm;\n  margin: 0 auto 40px auto;\n  background-color: #ffffff;\n  border: 1.5px solid #cbd5e1;\n  box-shadow: var(--shadow-lg);\n  padding: 50px 40px;\n  color: #000000;\n  position: relative;\n  box-sizing: border-box;\n  direction: rtl;\n}\r\n.report-print-logo-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-bottom: 3px solid #1f2937;\n  padding-bottom: 16px;\n  margin-bottom: 24px;\n}\r\n.report-header-brand {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\r\n.report-header-logo {\n  height: 48px;\n  max-height: 48px;\n  width: auto;\n  object-fit: contain;\n  display: block;\n}\r\n.company-logo-placeholder {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  font-weight: 800;\n  color: #1e3a8a;\n  background-color: #e6f0fa;\n  padding: 6px 12px;\n  border: 1.5px solid #1e3a8a;\n  border-radius: 4px;\n}\r\n.company-logo-placeholder svg {\n  width: 24px;\n  height: 24px;\n}\r\n.report-header-text {\n  flex: 1;\n  padding-right: 20px;\n  text-align: right;\n}\r\n.report-header-text h2 {\n  font-size: 16px;\n  font-weight: 800;\n  color: #111827;\n  margin: 0;\n}\r\n.report-header-text p {\n  font-size: 11px;\n  color: #4b5563;\n  margin: 4px 0 0 0;\n  font-weight: 600;\n}\r\n.report-doc-no {\n  text-align: left;\n}\r\n.report-badge {\n  background-color: #e6f0fa;\n  color: #1e3a8a;\n  font-size: 11px;\n  font-weight: 800;\n  padding: 4px 8px;\n  border-radius: 4px;\n  border: 1px solid #1e3a8a;\n  display: inline-block;\n  margin-bottom: 8px;\n}\r\n.report-no-lbl {\n  font-size: 11px;\n  color: #64748b;\n  margin: 0 0 2px 0;\n}\r\n.report-main-title {\n  text-align: center;\n  margin-bottom: 24px;\n}\r\n.report-main-title h1 {\n  font-size: 20px;\n  font-weight: 800;\n  color: #111827;\n  margin: 0 0 4px 0;\n}\r\n.report-main-title span {\n  font-size: 13px;\n  color: #4b5563;\n  font-weight: 700;\n}\r\n.report-info-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 10px;\n  background-color: #f8fafc;\n  border: 1.5px solid #cbd5e1;\n  padding: 16px;\n  border-radius: 6px;\n  margin-bottom: 24px;\n}\r\n.info-cell {\n  font-size: 13px;\n  color: #1f2937;\n  text-align: right;\n}\r\n.cell-lbl {\n  color: #64748b;\n  font-weight: 700;\n  margin-left: 6px;\n}\r\n.report-kpi-row {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n  margin-bottom: 24px;\n}\r\n.kpi-mini-box {\n  background-color: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 6px;\n  padding: 10px;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\r\n.kpi-lbl {\n  font-size: 11px;\n  color: #64748b;\n  font-weight: 700;\n  margin-bottom: 4px;\n}\r\n.kpi-mini-box strong {\n  font-size: 15px;\n  font-weight: 800;\n  color: #111827;\n}\r\n.kpi-mini-box.status-accepted strong {\n  color: #16a34a;\n}\r\n.kpi-mini-box.status-rejected strong {\n  color: #dc2626;\n}\r\n.report-section-header {\n  font-size: 14.5px;\n  font-weight: 800;\n  color: #111827;\n  margin: 0 0 12px 0;\n  padding-bottom: 4px;\n  border-bottom: 2px dashed #94a3b8;\n}\r\n.print-notes-box {\n  margin-top: 24px;\n  padding: 16px;\n  background-color: #fffbeb;\n  border-right: 4px solid #d97706;\n  border-radius: 4px;\n  font-size: 13px;\n  margin-bottom: 24px;\n  text-align: right;\n}\r\n.print-notes-box strong {\n  display: block;\n  margin-bottom: 6px;\n  color: #92400e;\n}\r\n.report-signature-row {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 40px;\n  padding-top: 20px;\n  border-top: 1px solid #e2e8f0;\n}\r\n.sig-column {\n  flex: 1;\n  text-align: center;\n}\r\n.sig-column p {\n  font-size: 13px;\n  font-weight: 700;\n  color: #111827;\n  margin: 0 0 45px 0;\n}\r\n.sig-line {\n  width: 180px;\n  height: 1px;\n  background-color: #475569;\n  margin: 0 auto 8px auto;\n}\r\n.sig-date-placeholder {\n  font-size: 11px;\n  color: #64748b;\n}\r\n.report-print-footer {\n  margin-top: 32px;\n  padding-top: 10px;\n  border-top: 1px solid #cbd5e1;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 10px;\n  color: #64748b;\n  direction: rtl;\n}\r\n.report-print-footer-brand {\n  font-weight: 700;\n  color: #334155;\n}\r\n.report-print-footer-meta {\n  direction: ltr;\n  font-weight: 600;\n}\r\n/* Printing styling */\r\n@page {\n  size: A4 portrait;\n  margin: 12mm;\n}\r\n@media print {\n  body {\n    background-color: white !important;\n    color: black !important;\n    height: auto !important;\n    width: 100% !important;\n    direction: rtl !important;\n    font-size: 12px !important;\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n  \n  /* Hide UI elements during print */\n  .page-header,\n  .sidebar,\n  .toolbar-wrapper,\n  .no-print,\n  .quality-print-actions,\n  .quality-mui-stepper,\n  .wizard-stepbar-wrap,\n  .wizard-nav-row,\n  .kpi-grid,\n  .defect-categories-percentage-container {\n    display: none !important;\n  }\n  \n  .app-container,\n  .main-content,\n  .step-viewport {\n    display: block !important;\n    height: auto !important;\n    overflow: visible !important;\n    padding: 0 !important;\n    background: none !important;\n  }\n  \n  .print-layout-container,\n  .qrev-print-report {\n    display: block !important;\n    width: 100% !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .a4-print-sheet {\n    border: none !important;\n    box-shadow: none !important;\n    padding: 0 !important;\n    width: 100% !important;\n    min-height: auto !important;\n    margin: 0 !important;\n    background: white !important;\n  }\n\n  .report-print-logo-row,\n  .report-main-title,\n  .report-info-grid,\n  .report-kpi-row,\n  .print-notes-box,\n  .report-signature-row,\n  .report-print-footer {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n  \n  .excel-matrix-table {\n    border: 2px solid #000000 !important;\n  }\n  \n  .excel-matrix-table th {\n    background-color: #cbd5e1 !important;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n    border: 2px solid #000000 !important;\n  }\n  \n  .excel-matrix-table td {\n    border: 1px solid #000000 !important;\n  }\n\n  .excel-matrix-table tr {\n    break-inside: avoid;\n    page-break-inside: avoid;\n  }\n}\r\n/* ==========================================================================\n   GRPO Weighbridge Shipment Cards (Strict Alignment & Uniform Rhythm)\n   ========================================================================== */\r\n.grpo-scale-card {\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n  gap: 8px !important;\n  padding: 12px 14px !important;\n  border: 1px solid var(--border) !important;\n  border-radius: var(--radius-md, 8px) !important;\n  background: var(--color-bg, var(--bg-elevated)) !important;\n  box-shadow: var(--shadow-sm) !important;\n  transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease !important;\n  box-sizing: border-box !important;\n}\r\n.grpo-scale-card:hover {\n  border-color: var(--accent, #0284c7) !important;\n  box-shadow: var(--shadow-md) !important;\n  transform: translateY(-2px);\n}\r\n/* A. Deterministic 2-Row Header */\r\n.grpo-scale-card__header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-bottom: 1px solid var(--border);\n  padding-bottom: 8px;\n  gap: 8px;\n  min-height: 48px;\n  box-sizing: border-box;\n}\r\n.grpo-scale-card__vehicle-box {\n  display: flex;\n  align-items: flex-start;\n  gap: 6px;\n  flex: 1 1 auto;\n  min-width: 0;\n}\r\n.grpo-scale-card__truck-icon {\n  font-size: 1.15rem;\n  line-height: 1.2;\n  flex-shrink: 0;\n  margin-top: 1px;\n}\r\n.grpo-scale-card__vehicle-title {\n  font-size: 1rem;\n  font-weight: 700;\n  color: var(--text);\n  line-height: 1.25;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  word-break: break-word;\n  overflow-wrap: anywhere;\n}\r\n.grpo-scale-card__badges-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  flex-shrink: 0;\n}\r\n.grpo-scale-card__badge-row {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  justify-content: flex-end;\n}\r\n.grpo-scale-card .rr-status-badge {\n  font-size: 0.72rem;\n  padding: 2px 6px;\n  line-height: 1.3;\n  white-space: nowrap !important;\n}\r\n.grpo-scale-card__scale-badge {\n  background: rgba(16, 185, 129, 0.12) !important;\n  color: #059669 !important;\n  border: 1px solid rgba(16, 185, 129, 0.3) !important;\n  font-weight: 600;\n  border-radius: 4px;\n}\r\n.grpo-scale-card__delete-btn {\n  padding: 2px 5px !important;\n  min-height: auto !important;\n  font-size: 0.8rem !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  line-height: 1 !important;\n}\r\n/* B. Stable 3-Column Ticket Strip */\r\n.grpo-scale-card__ticket-strip {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 6px;\n  padding: 3px 8px;\n  background: var(--bg-soft, rgba(0, 0, 0, 0.03));\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  min-height: 28px;\n  box-sizing: border-box;\n}\r\n.grpo-scale-card__ticket-label {\n  font-size: 0.72rem;\n  font-weight: 600;\n  color: var(--text-muted);\n  white-space: nowrap !important;\n  flex-shrink: 0;\n}\r\n.grpo-scale-card__ticket-number {\n  font-family: var(--font-mono, monospace);\n  font-weight: 600;\n  font-size: 0.74rem;\n  color: var(--text);\n  background: var(--bg-elevated, #fff);\n  padding: 1px 6px;\n  border-radius: 3px;\n  border: 1px solid var(--border);\n  white-space: nowrap !important;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  direction: ltr !important;\n  unicode-bidi: isolate !important;\n  max-width: 140px;\n  text-align: center;\n}\r\n.grpo-scale-card__ticket-date {\n  font-size: 0.72rem;\n  font-weight: 500;\n  color: var(--text-muted);\n  white-space: nowrap !important;\n  flex-shrink: 0;\n  direction: ltr !important;\n  unicode-bidi: isolate !important;\n}\r\n/* C. Grouped Supplier & Product Box */\r\n.grpo-scale-card__info-box {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-around;\n  gap: 6px;\n  background: var(--bg-soft, rgba(0, 0, 0, 0.025));\n  padding: 8px 10px;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  min-height: 98px;\n  box-sizing: border-box;\n}\r\n.grpo-scale-card__info-item {\n  display: grid;\n  gap: 1px;\n}\r\n.grpo-scale-card__info-label {\n  font-size: 0.7rem;\n  font-weight: 600;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\r\n.grpo-scale-card__info-val {\n  font-size: 0.84rem;\n  font-weight: 600;\n  color: var(--text);\n  line-height: 1.3;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\r\n.grpo-scale-card__info-warehouse {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-top: 3px;\n  border-top: 1px dashed var(--border);\n}\r\n/* D. Prominent Certified Net Weight Block */\r\n.grpo-scale-card__weight-block {\n  background: var(--bg-elevated, #f8fafc);\n  border: 1px solid var(--border);\n  border-inline-start: 3px solid #059669;\n  border-radius: 6px;\n  padding: 6px 10px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  min-height: 48px;\n  box-sizing: border-box;\n}\r\n.grpo-scale-card__weight-info {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n}\r\n.grpo-scale-card__weight-label {\n  font-size: 0.72rem;\n  font-weight: 600;\n  color: var(--text-muted);\n}\r\n.grpo-scale-card__weight-certified {\n  font-size: 0.68rem;\n  color: #059669;\n  font-weight: 600;\n  white-space: nowrap !important;\n}\r\n.grpo-scale-card__weight-value-wrap {\n  display: flex;\n  align-items: baseline;\n  gap: 4px;\n  direction: ltr !important;\n  unicode-bidi: isolate !important;\n}\r\n.grpo-scale-card__weight-val {\n  font-size: 1.25rem;\n  font-weight: 700;\n  color: var(--text);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap !important;\n  direction: ltr !important;\n}\r\n.grpo-scale-card__weight-unit {\n  font-size: 0.78rem;\n  font-weight: 600;\n  color: var(--text-muted);\n  white-space: nowrap !important;\n}\r\n/* E. Card Footer */\r\n.grpo-scale-card__footer {\n  margin-top: auto;\n  padding-top: 8px;\n  border-top: 1px dashed var(--border);\n}\r\n.grpo-scale-card .grpo-scale-card__cta {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  gap: 6px !important;\n  padding: 6px 12px !important;\n  font-size: 0.85rem !important;\n  min-height: var(--grpo-card-action-height, 34px);\n  box-sizing: border-box !important;\n}\r\n/* Manual GRPO Card Variants (Shares .grpo-scale-card geometry) */\r\n.grpo-manual-card__badge {\n  background: rgba(14, 165, 233, 0.15) !important;\n  color: #0284c7 !important;\n  border: 1px solid rgba(14, 165, 233, 0.4) !important;\n  font-weight: 600;\n  border-radius: 4px;\n}\r\n.grpo-manual-card__weight-block {\n  border-inline-start: 3px solid #0284c7 !important;\n}\r\n.grpo-manual-card__weight-sublabel {\n  font-size: 0.68rem;\n  color: #0284c7;\n  font-weight: 600;\n  white-space: nowrap !important;\n}\r\n/* Customization & Delivery landing layout. Card visuals come from the shared\n   Home / Production design system. */\r\n.customization-delivery-page .three-cards-grid {\n  width: min(1100px, 100%);\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n  margin: 0 auto;\n  align-items: stretch;\n}\r\n.customization-delivery-page .module-card {\n  height: 100%;\n}\r\n.customization-delivery-page .step-badge {\n  position: absolute;\n  top: 12px;\n  inset-inline-end: 12px;\n  font-size: 0.72rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  padding: 4px 9px;\n  border-radius: 999px;\n  background: var(--bg-primary-soft);\n  color: var(--primary);\n  border: 1px solid var(--border);\n}\r\n.customization-delivery-page .nav-card {\n  height: 100%;\n}\r\nhtml[data-theme='dark'] .sales-quotations-empty-state {\n  background: var(--bg-elevated) !important;\n  border-color: var(--border) !important;\n  color: var(--text) !important;\n  box-shadow: var(--shadow-md) !important;\n}\r\nhtml[data-theme='dark'] .sales-quotations-empty-state__title {\n  color: var(--text) !important;\n}\r\nhtml[data-theme='dark'] .sales-quotations-empty-state__description {\n  color: var(--text-muted) !important;\n}\r\nhtml[data-theme='dark'] .sales-quotations-empty-state__icon {\n  background: var(--bg-primary-soft) !important;\n  color: var(--primary) !important;\n}\r\nhtml[data-theme='dark'] .sales-quotations-empty-state .app-button--secondary {\n  background: var(--bg-soft);\n  border-color: var(--border);\n  color: var(--text);\n}\r\nhtml[data-theme='dark'] .sales-quotations-empty-state .app-button--primary {\n  background: var(--primary);\n  color: var(--on-accent, #ffffff);\n}\r\n/* Quotation Cards in Sales Quotations Page */\r\n.quotations-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));\n  gap: 20px;\n}\r\n.quotation-card {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  color: var(--text);\n  border-radius: 12px;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  box-shadow: var(--shadow-sm);\n  transition: border-color var(--transition), box-shadow var(--transition);\n}\r\n.quotation-card:hover {\n  border-color: var(--border-strong);\n  box-shadow: var(--shadow-md);\n}\r\nhtml[data-theme='dark'] .quotation-card {\n  background: var(--bg-elevated);\n  border-color: var(--border);\n  color: var(--text);\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.24);\n}\r\nhtml[data-theme='dark'] .quotation-card:hover {\n  border-color: var(--border-strong);\n}\r\n.quotation-card__metrics {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 8px;\n  padding: 10px;\n  border-radius: 8px;\n  background: var(--bg-soft);\n  border: 1px solid var(--border);\n  text-align: center;\n}\r\nhtml[data-theme='dark'] .quotation-card__metrics {\n  background: var(--bg-soft);\n  border-color: var(--border);\n}\r\n@media (max-width: 900px) {\n  .customization-delivery-page .three-cards-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 16px;\n  }\n}\r\n@media (max-width: 600px) {\n  .customization-delivery-page .three-cards-grid {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n\n  .quotations-grid {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n}\r\n.workflow-pagination { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; margin-block: 24px; }\r\n.workflow-pagination button { min-height: 44px; }\r\nbody:has(.sales-readiness-workflow) .app-toolbar__content { flex-wrap: wrap; }\r\nbody:has(.sales-readiness-workflow) .app-toolbar__actions { min-width: 0; max-width: 100%; flex-wrap: wrap; }\r\n/* When sales breadcrumbs wrap the toolbar, align the first menu to its\n   trigger's start edge so it cannot extend past the viewport's start. */\r\n@media screen and (min-width: 1101px) {\n  body:has(.sales-readiness-workflow) .toolbar-review-menu--review > .toolbar-review-menu__list {\n    inset-inline-start: 0;\n    inset-inline-end: auto;\n  }\n}\r\n@media (max-width: 768px) {\n  .sales-readiness-workflow { min-width: 0; max-width: 100%; }\n  .sales-readiness-workflow .cd-table-wrap { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; }\n  .sales-readiness-workflow .cd-table { min-width: 760px; }\n  .sales-readiness-workflow .cd-table-wrap::before { content: attr(aria-label); display: block; position: sticky; inset-inline-start: 0; font-size: 12px; color: var(--text-muted); padding-block: 8px; width: fit-content; }\n  .sales-readiness-workflow .app-button { min-height: 44px; max-width: 100%; white-space: normal; }\n  .sales-readiness-workflow .card-panel { min-width: 0; overflow-wrap: anywhere; }\n  .sales-readiness-workflow .card-panel > div[style*=\"display: flex\"] { flex-wrap: wrap; }\n}\r\n/* Customization & Delivery module - read-only screens.\n   Scoped to .cd-* classes so nothing here can affect existing modules. */\r\n.cd-filters {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  gap: 12px;\n  margin-bottom: 16px;\n}\r\n.cd-field {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 0.8rem;\n  color: var(--text-muted, inherit);\n}\r\n.cd-field .app-input {\n  min-width: 150px;\n}\r\n.cd-filter-actions {\n  margin-inline-start: auto;\n}\r\n.cd-table-view {\n  display: block;\n  width: 100%;\n  min-width: 0;\n  max-width: 100%;\n}\r\n.cd-cards-view {\n  display: none;\n}\r\n.cd-table-wrap {\n  overflow-x: auto;\n  max-width: 100%;\n  width: 100%;\n  min-width: 0;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  -webkit-overflow-scrolling: touch;\n}\r\n.cd-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.82rem;\n}\r\n.cd-table th,\n.cd-table td {\n  padding: 7px 8px;\n  text-align: start;\n  border-bottom: 1px solid var(--border);\n}\r\n.cd-table th {\n  font-weight: 600;\n  background: var(--bg-soft);\n  color: var(--text);\n  white-space: nowrap;\n}\r\n.cd-table tbody tr:last-child td {\n  border-bottom: none;\n}\r\n/* Compact desktop/tablet adjustments (<= 1100px) */\r\n@media (max-width: 1100px) {\n  .cd-table {\n    font-size: 0.8rem;\n  }\n\n  .cd-table th,\n  .cd-table td {\n    padding: 8px 6px;\n  }\n\n  .cd-table .doc-trace-chain--inline {\n    gap: 3px;\n  }\n\n  .cd-table .doc-trace-chip {\n    padding: 2px 6px;\n    font-size: 0.72rem;\n  }\n\n  .cd-table .app-button.app-button--compact {\n    padding: 3px 6px;\n    font-size: 0.75rem;\n  }\n\n  .cd-muted {\n    font-size: 0.72rem;\n  }\n}\r\n/* Standard Compact App Button */\r\n.app-button--compact {\n  min-height: var(--compact-action-height, 32px);\n  height: 32px;\n  padding: 5px 10px !important;\n  font-size: 0.82rem !important;\n  font-weight: 600;\n  border-radius: var(--radius-md);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n}\r\n/* Mobile & tablet portrait stacked cards (<= 850px) */\r\n@media (max-width: 850px) {\n