n;\n  gap: 8px;\n  margin-top: 16px;\n  padding: 0;\n  border: 0;\n  background: transparent;\n}\r\n/* KPIs in results step */\r\n.kpi-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: var(--space-4);\n  margin-bottom: var(--space-5);\n}\r\n.kpi-card {\n  background-color: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  padding: var(--space-4);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n  box-shadow: var(--shadow-sm);\n}\r\n.kpi-card--success {\n  border-inline-start: 4px solid var(--color-success);\n}\r\n.kpi-card--warning {\n  border-inline-start: 4px solid var(--color-warning);\n}\r\n.kpi-card--danger {\n  border-inline-start: 4px solid var(--color-danger);\n}\r\n.kpi-val {\n  font-size: 1.8rem;\n  font-weight: 800;\n  color: var(--color-text);\n}\r\n.kpi-val--decision {\n  font-size: 1.18rem;\n  line-height: 1.25;\n  overflow-wrap: anywhere;\n}\r\n.kpi-label {\n  font-size: 0.85rem;\n  color: var(--color-text-muted);\n  font-weight: 600;\n}\r\n/* Excel Matrix Styles */\r\n.excel-matrix-wrapper {\n  overflow-x: auto;\n  border: 1px solid var(--color-border-strong);\n  border-radius: var(--radius-md);\n  margin-bottom: var(--space-5);\n}\r\n.excel-matrix-table {\n  width: 100%;\n  font-size: 0.82rem;\n  border-collapse: collapse;\n  text-align: center;\n}\r\n.excel-matrix-table th {\n  background-color: var(--color-surface-muted);\n  border: 1px solid var(--color-border-strong);\n  padding: var(--space-2) var(--space-3);\n  font-weight: 800;\n  color: var(--color-text);\n}\r\n.excel-matrix-table__first-col {\n  width: 220px;\n}\r\n.excel-category-row td {\n  background: var(--color-surface-muted);\n  font-size: 0.85rem;\n  font-weight: 800;\n  text-align: start;\n}\r\n.excel-matrix-table__total,\n.excel-matrix-table__summary {\n  font-weight: 800;\n}\r\n.excel-matrix-table__summary {\n  text-align: start;\n}\r\n.excel-matrix-table td {\n  border: 1px solid var(--color-border);\n  padding: var(--space-2) var(--space-3);\n  color: var(--color-text);\n  background-color: var(--color-surface);\n}\r\n.excel-matrix-table tr:nth-child(even) td {\n  background-color: var(--color-surface-muted);\n}\r\n.excel-matrix-table td.defect-row-header {\n  text-align: start;\n  font-weight: 800;\n  background-color: var(--color-surface-muted);\n  border-inline-end: 2px solid var(--color-border-strong);\n}\r\n.excel-matrix-table tr.totals-row td {\n  font-weight: 800;\n  background-color: var(--color-surface-muted);\n  border-top: 2px solid var(--color-border-strong);\n  border-bottom: 4px double var(--color-text);\n}\r\n.excel-matrix-table tr.totals-row--grand td {\n  border-bottom: 4px double var(--color-text);\n}\r\n.notes-report-box {\n  margin-bottom: var(--space-5);\n  padding: var(--space-4);\n  background-color: var(--color-warning-soft);\n  border-inline-start: 4px solid var(--color-warning);\n  border-radius: var(--radius-sm);\n  font-size: 0.9rem;\n  color: var(--color-text);\n}\r\n/* Print Layout */\r\n.print-layout-container {\n  background: white;\n  color: black;\n  padding: 40px;\n  font-family: var(--font-body);\n  direction: rtl;\n}\r\n.print-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-bottom: 2px solid black;\n  padding-bottom: 20px;\n  margin-bottom: 20px;\n}\r\n.print-logo-box {\n  font-size: 1.5rem;\n  font-weight: 800;\n  color: #0f5ca8;\n}\r\n.print-title {\n  text-align: center;\n}\r\n.print-title h2 {\n  margin: 0;\n  font-size: 1.4rem;\n  font-weight: 800;\n}\r\n.print-metadata-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 15px;\n  border: 1px solid #cbd5e1;\n  padding: 15px;\n  border-radius: 4px;\n  margin-bottom: 20px;\n  font-size: 0.85rem;\n}\r\n.print-meta-item strong {\n  color: #374151;\n}\r\n.print-signatures {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 50px;\n  padding-top: 20px;\n  border-top: 1px solid #cbd5e1;\n}\r\n.signature-box {\n  width: 200px;\n  text-align: center;\n  font-size: 0.85rem;\n}\r\n.signature-box .line {\n  border-bottom: 1.5px solid #94a3b8;\n  height: 40px;\n  margin-bottom: 10px;\n}\r\n@media (min-width: 961px) {\n  .quality-wizard-card.card-panel {\n    max-height: calc(100dvh - 250px);\n    overflow-y: auto;\n  }\n}\r\n@media (max-width: 960px) {\n  .app-content:has(.quality-wizard) {\n    padding-top: 10px;\n  }\n\n  .quality-wizard {\n    gap: 10px;\n  }\n\n  .quality-stepper,\n  .quality-mui-stepper,\n  .quality-wizard-card,\n  .quality-wizard-card--wide {\n    width: 100%;\n    max-width: 100%;\n  }\n\n  .quality-stepper .wizard-stepbar-wrap {\n    padding-top: 6px;\n    padding-bottom: 8px;\n  }\n\n  .quality-form-grid,\n  .defects-category-grid,\n  .kpi-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .quality-sample-heading {\n    flex-direction: column;\n  }\n\n  .sample-completion-badge {\n    align-self: flex-start;\n  }\n\n  .quality-print-actions,\n  .qrev-actions,\n  .wizard-nav-row,\n  .sample-inner-nav {\n    flex-wrap: wrap;\n  }\n\n  .qrev-icon-btn {\n    flex-basis: 36px;\n    width: 36px;\n    height: 36px;\n  }\n}\r\n@media (max-width: 560px) {\n  .quality-mui-stepper {\n    overflow-x: auto;\n    padding-inline: 4px;\n    scrollbar-width: none;\n  }\n\n  .quality-mui-stepper::-webkit-scrollbar {\n    display: none;\n  }\n\n  .quality-mui-stepper .MuiStep-root {\n    flex: 0 0 82px;\n    min-width: 82px;\n    padding-inline: 2px;\n  }\n\n  .quality-mui-stepper .MuiStepLabel-label {\n    max-width: 78px;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: normal;\n  }\n\n  .quality-mui-step-icon {\n    width: 30px;\n    height: 30px;\n    font-size: 12px;\n  }\n\n  .quality-mui-step-icon svg {\n    font-size: 16px;\n  }\n\n  .quality-mui-stepper .MuiStepConnector-root {\n    top: 15px;\n  }\n\n  .quality-stepper__meta {\n    align-items: flex-start;\n    flex-direction: col