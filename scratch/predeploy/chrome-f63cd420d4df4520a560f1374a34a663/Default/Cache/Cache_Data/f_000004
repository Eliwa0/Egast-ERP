cd-table-wrap {\n    overflow: visible;\n  }\n\n  .delivery-analytics-report--single .delivery-report-analytics-sections {\n    display: none !important;\n  }\n}\r\n.shipping-loading { max-width: 1200px; margin: auto; padding: 24px 16px; color: var(--color-text, #172b4d); }\r\n.shipping-loading button:not(.MuiButtonBase-root), .shipping-loading input:not(.MuiInputBase-input), .shipping-loading select {\n  font: inherit; min-height: 52px; padding: 12px 16px; border: 1px solid var(--color-border, #cbd5e1);\n  border-radius: 10px; color: inherit; background: var(--color-surface, white); box-sizing: border-box;\n}\r\n.shipping-loading button:not(.MuiButtonBase-root) { cursor: pointer; font-weight: 700; }\r\n.shipping-loading button:not(.MuiButtonBase-root):disabled { opacity: .55; cursor: default; }\r\n.shipping-loading :focus-visible { outline: 3px solid var(--color-primary, #1264ad); outline-offset: 3px; }\r\n.shipping-loading label:not(.MuiFormLabel-root) { display: grid; gap: 8px; min-width: 0; }\r\n.shipping-loading input:not(.MuiInputBase-input), .shipping-loading select { width: 100%; min-width: 0; }\r\n.shipping-loading .shipping-primary { background: var(--color-primary, #1264ad); color: white; }\r\n.shipping-cards, .shipping-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }\r\n.shipping-cards { margin: 24px 0; }\r\n.shipping-loading .shipping-card { display: grid; gap: 12px; text-align: start; padding: 24px; }\r\n.shipping-card h2 { margin: 4px 0; }\r\n.shipping-status { width: fit-content; padding: 6px 12px; border-radius: 8px; background: #fff4d6; color: #805400; font-size: .9rem; }\r\n.shipping-status--READY, .shipping-status--WEIGHED, .shipping-status--DELIVERY_CREATED { background: #dcfce7; color: #166534; }\r\n.shipping-ticket, .shipping-pallet { margin: 20px 0; padding: 20px; border: 1px solid var(--color-border, #cbd5e1); border-radius: 14px; background: var(--color-surface, white); overflow-wrap: anywher