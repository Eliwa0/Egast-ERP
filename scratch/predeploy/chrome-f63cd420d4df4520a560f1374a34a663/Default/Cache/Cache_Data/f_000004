ers-review__base-quotation {\n  margin-top: 5px;\n}\r\n.sales-orders-review__status {\n  white-space: nowrap;\n}\r\n@media (max-width: 900px) {\n  .sales-orders-review__filters-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\r\n@media (max-width: 580px) {\n  .sales-orders-review__filters-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .sales-orders-review-page > .page-header {\n    align-items: flex-start;\n  }\n}\r\n.cd-status {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 999px;\n  font-size: 0.75rem;\n  font-weight: 600;\n  background: rgba(127, 127, 127, 0.18);\n}\r\n.cd-status--bost_open,\n.cd-status--o {\n  background: rgba(59, 130, 246, 0.18);\n}\r\n.cd-status--bost_close,\n.cd-status--bost_paid,\n.cd-status--c,\n.cd-status--p {\n  background: rgba(16, 185, 129, 0.18);\n}\r\n.cd-status--bost_delivered,\n.cd-status--d {\n  background: rgba(139, 92, 246, 0.18);\n}\r\n.cd-status--none {\n  background: transparent;\n  color: var(--text-muted);\n}\r\n.cd-section {\n  margin-bottom: 16px;\n}\r\n.cd-section__title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0 0 12px;\n  font-size: 1rem;\n}\r\n.cd-count {\n  font-size: 0.75rem;\n  font-weight: 600;\n  padding: 1px 8px;\n  border-radius: 999px;\n  background: rgba(127, 127, 127, 0.18);\n}\r\n/* Document metadata grid.\n\n   `min-width: 0` on the items is what stops a long unbroken value (an Arabic\n   customer name, a long code) from forcing its track wider than the column and\n   colliding with the neighbouring field. `minmax(min(100%, 230px), 1fr)` keeps\n   the track from exceeding the container on narrow viewports, and the value\n   wraps instead of overflowing. */\r\n.cd-field-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));\n  gap: 16px 24px;\n}\r\n.cd-field-grid > * {\n  min-width: 0;\n}\r\n.cd-field-item {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}