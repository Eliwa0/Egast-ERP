adow 0.15s, transform 0.15s, color 0.15s;\n}\r\n\r\n.uom-card:hover {\n  transform: translateY(-1px);\n  box-shadow: var(--shadow-sm);\n}\r\n\r\n.uom-card__name {\n  text-align: right;\n  flex: 1;\n}\r\n\r\n.uom-card__entry {\n  flex-shrink: 0;\n  opacity: 0.7;\n  font-variant-numeric: tabular-nums;\n}\r\n\r\n/* ── Wizard main step bar ───────────────────────────────────────────────── */\r\n\r\n.wizard-stepbar-wrap {\n  display: flex;\n  align-items: flex-start;\n  padding: 20px 16px 28px;\n  overflow-x: auto;\n}\r\n\r\n.wizard-step {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  min-width: 64px;\n  gap: 6px;\n  cursor: default;\n  transition: opacity 0.15s;\n}\r\n\r\n.wizard-step--locked {\n  opacity: 0.38;\n  cursor: not-allowed;\n}\r\n\r\n.wizard-step--clickable {\n  cursor: pointer;\n}\r\n\r\n.wizard-step__circle {\n  width: 42px;\n  height: 42px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 18px;\n  font-weight: 700;\n  border: 2.5px solid var(--border);\n  background: var(--bg-muted);\n  color: var(--text-subtle);\n  flex-shrink: 0;\n  transition: background 0.18s, border-color 0.18s, transform 0.18s, box-shadow 0.18s;\n}\r\n\r\n.wizard-step--done .wizard-step__circle {\n  background: var(--success);\n  border-color: var(--success);\n  color: #fff;\n  font-size: 15px;\n}\r\n\r\n.wizard-step--active .wizard-step__circle {\n  background: var(--primary);\n  border-color: var(--primary);\n  color: #fff;\n  box-shadow: 0 0 0 4px var(--bg-primary-soft);\n}\r\n\r\n.wizard-step--clickable:hover .wizard-step__circle {\n  transform: scale(1.1);\n}\r\n\r\n.wizard-step__label {\n  font-size: 10px;\n  font-weight: 600;\n  text-align: center;\n  white-space: nowrap;\n  color: var(--text-subtle);\n  transition: color 0.15s;\n}\r\n\r\n.wizard-step--done .wizard-step__label {\n  color: var(--success);\n}\r\n\r\n.wizard-step--active .wizard-step__label {\n  color: var(--primary);\n}\r\n\r\n.