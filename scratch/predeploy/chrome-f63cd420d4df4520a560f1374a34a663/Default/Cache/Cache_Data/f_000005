ize: 13px;\n  color: var(--text-muted);\n  line-height: 1;\n  padding: 0;\n}\r\n\r\n.wh-dropdown {\n  position: absolute;\n  top: calc(100% + 4px);\n  left: 0;\n  right: 0;\n  z-index: 200;\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  box-sizing: border-box;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);\n  max-height: 260px;\n  overflow-y: auto;\n  overflow-x: hidden;\n}\r\n\r\n.wh-dropdown__empty {\n  padding: 12px;\n  font-size: 12px;\n  color: var(--text-subtle);\n  text-align: center;\n}\r\n\r\n.wh-dropdown__item {\n  padding: 9px 12px;\n  cursor: pointer;\n  border-bottom: 1px solid var(--border);\n  background: transparent;\n  max-width: 100%;\n  min-width: 0;\n  box-sizing: border-box;\n  overflow-wrap: anywhere;\n}\r\n\r\n.wh-dropdown__item--selected {\n  background: var(--bg-primary-soft);\n}\r\n\r\n.wh-dropdown__item-code {\n  font-weight: 700;\n  font-size: 13px;\n  color: var(--text);\n}\r\n\r\n.wh-dropdown__item-code--selected {\n  color: var(--primary);\n}\r\n\r\n.wh-dropdown__item-name {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-left: 6px;\n  overflow-wrap: anywhere;\n}\r\n\r\n/* ── Selected warehouse badge (below search) ─────────────────────────────── */\r\n\r\n.wh-selected-badge {\n  margin-top: 10px;\n  padding: 8px 10px;\n  border-radius: 7px;\n  background: var(--bg-primary-soft);\n  border: 1px solid rgba(37, 99, 235, 0.25);\n  font-size: 12px;\n}\r\n\r\n.wh-selected-badge__code {\n  font-weight: 700;\n  color: var(--primary);\n}\r\n\r\n.wh-selected-badge__name {\n  color: var(--text-muted);\n  margin-left: 6px;\n}\r\n\r\n.wh-selected-badge__hidden-count {\n  font-size: 11px;\n  color: var(--warning);\n  margin-top: 2px;\n}\r\n\r\n/* ── Order visibility list ────────────────────────────────────────────────── */\r\n\r\n.ov-order-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin-bottom: 20px;\n  max-h