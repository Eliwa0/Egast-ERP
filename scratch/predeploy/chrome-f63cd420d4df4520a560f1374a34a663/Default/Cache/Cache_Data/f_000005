dding: 8px 14px;\n  border-radius: 8px;\n  font-size: 12px;\n  background: var(--bg-primary-soft);\n  color: var(--primary);\n  border: 1px solid rgba(37, 99, 235, 0.2);\n}\r\n\r\n.rr-stats-row {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\r\n\r\n.rr-stat-chip {\n  padding: 6px 14px;\n  border-radius: 9px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\r\n\r\n.rr-stat-chip__value {\n  font-size: 19px;\n  font-weight: 800;\n}\r\n\r\n.rr-stat-chip__label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\r\n\r\n.rr-filter-bar {\n  padding: 10px 12px;\n  border-radius: 10px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n  align-items: flex-end;\n}\r\n\r\n.rr-filter-label {\n  display: block;\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--text-muted);\n  margin-bottom: 3px;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\r\n\r\n.rr-filter-input {\n  font-size: 12px;\n  padding: 4px 7px;\n  height: 30px;\n}\r\n\r\n.rr-filter-status { min-width: 116px; }\r\n\r\n.rr-filter-clear-btn {\n  height: 30px;\n  font-size: 11px;\n  padding: 0 10px;\n}\r\n\r\n.rr-col-pills {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n  align-items: center;\n}\r\n\r\n.rr-col-pills__text {\n  font-size: 11px;\n  color: var(--text-muted);\n}\r\n\r\n.rr-col-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  border-radius: 999px;\n  font-size: 11px;\n  background: var(--bg-primary-soft);\n  color: var(--primary);\n  border: 1px solid rgba(37, 99, 235, 0.25);\n}\r\n\r\n.rr-col-pill__clear {\n  background: none;\n  border: none;\n  cursor: pointer;\n  font-size: 12px;\n  color: var(--primary);\n  padding: 0 1px;\n  line-height: 1;\n}\r\n\r\n.rr-col-pills__clear-all {\n  height: 24px;\n  font-size: 10px;\n  padding: 0 8px;\n}\r\n\r\n.rr-import-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 320;\n  background: rgba(0, 0, 0, 0.45);\n}\r\n\r\n.rr-import-modal {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  z-index: 321;\n  width: 780px;\n  max-width: 96vw;\n  max-height: 86vh;\n  overflow: auto;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 18px;\n  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.24);\n}\r\n\r\n.rr-import-modal__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 12px;\n}\r\n\r\n.rr-import-modal__title {\n  font-size: 16px;\n  font-weight: 800;\n  color: var(--text);\n}\r\n\r\n.rr-import-modal__subtitle {\n  font-size: 12px;\n  color: var(--text-muted);\n}\r\n\r\n.rr-import-modal__close-btn {\n  min-height: 30px;\n  font-size: 12px;\n  padding: 3px 10px;\n}\r\n\r\n.rr-import-modal__error-mb {\n  margin-bottom: 12px;\n}\r\n\r\n.rr-import-modal__stats {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  margin-bottom: 12px;\n}\r\n\r\n.rr-import-modal__stat {\n  padding: 6px 10px;\n  border-radius: 8px;\n  background: var(--bg-soft);\n  border: 1px solid var(--border);\n  font-size: 12px;\n  color: var(--text);\n}\r\n\r\n.rr-import-table-wrap {\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  overflow: hidden;\n  margin-bottom: 14px;\n}\r\n\r\n.rr-import-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 11px;\n}\r\n\r\n.rr-import-table thead tr {\n  background: var(--bg-muted);\n  color: var(--text-muted);\n}\r\n\r\n.rr-import-table th {\n  text-align: left;\n  padding: 7px;\n  border-bottom: 1px solid var(--border);\n}\r\n\r\n.rr-import-table td {\n  padding: 7px;\n  border-bottom: 1px solid var(--border);\n}\r\n\r\n.rr-import-table__warning { color: var(--warning); }\r\n\r\n.rr-import-table__error   { color: var(--danger); }\r\n\r\n.rr-import-modal__note {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 10px;\n}\r\n\r\n.rr-import-modal__actions {\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n}\r\n\r\n.rr-import-modal__action-btn { min-height: 38px; }\r\n\r\n.rr-grid-loading {\n  text-align: center;\n  padding: 40px;\n  color: var(--text-subtle);\n}\r\n\r\n.rr-grid-empty {\n  padding: 40px;\n  text-align: center;\n  border-radius: 12px;\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  color: var(--text-subtle);\n  font-size: 14px;\n}\r\n\r\n.rr-grid-wrap {\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--bg-elevated);\n  overflow: clip;\n}\r\n\r\n.rr-grid-scroll {\n  overflow-x: auto;\n  max-height: calc(100vh - 280px);\n  overflow-y: auto;\n}\r\n\r\n.receipt-review-table th,\n.receipt-review-table td {\n  line-height: 1.35 !important;\n}\r\n\r\n.receipt-review-table td,\n.receipt-review-table td span {\n  font-size: 12px !important;\n}\r\n\r\n.receipt-review-table th span,\n.receipt-review-table .col-filter-btn {\n  font-size: 11px !important;\n  line-height: 1.25 !important;\n}\r\n\r\n.receipt-review-table .rr-status-badge {\n  font-size: 11px !important;\n  line-height: 1.25 !important;\n}\r\n\r\n.receipt-review-table .cell-input,\n.receipt-review-table .add-units-input {\n  min-height: 28px;\n  padding: 5px 6px;\n  font-size: 12px !important;\n  line-height: 1.3 !important;\n}\r\n\r\n.receipt-review-table .rr-table-cell--long-text {\n  white-space: normal !important;\n  word-break: normal !important;\n  overflow-wrap: break-word;\n}\r\n\r\n/* ── ReceiptReviewPage table internals ───────────────────────────────────── */\r\n\r\n.cell-input {\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 3px 5px;\n  font-size: 11px;\n  color: var(--text);\n  font-family: inherit;\n  box-sizing: border-box;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\r\n\r\n.cell-input:focus {\n  outline: none;\n  border-color: var(--primary);\n  background: var(--bg-elevated);\n  box-shadow: 0 0 0 2px var(--bg-primary-soft);\n}\r\n\r\n.cell-input:hover:not(:focus) { border-color: var(--border-strong); }\r\n\r\n.cell-input:disabled { opacity: 0.5; cursor: not-allowed; }\r\n\r\n.rr-row.rr-selected > td { background: var(--bg-primary-soft) !important; }\r\n\r\n.rr-row:hover:not(.rr-selected) > td { filter: brightness(0.965); }\r\n\r\n[data-theme=\"dark\"] .rr-row:hover:not(.rr-selected) > td { filter: brightness(1.06); }\r\n\r\n.col-filter-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 0;\n  font-weight: 700;\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  display: flex;\n  align-items: center;\n  gap: 3px;\n  white-space: nowrap;\n}\r\n\r\n.col-filter-btn.active { color: var(--primary) !important; }\r\n\r\n.order-change-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 1px 4px;\n  font-size: 10px;\n  color: var(--text-muted);\n  border-radius: 3px;\n  line-height: 1;\n  opacity: 0.7;\n}\r\n\r\n.order-change-btn:hover { opacity: 1; color: var(--primary); background: var(--bg-primary-soft); }\r\n\r\n.add-units-input {\n  width: 100%;\n  min-width: 0;\n  background: var(--bg-warning-soft);\n  border: 1px solid rgba(183, 121, 31, 0.4);\n  border-radius: 4px;\n  padding: 3px 5px;\n  font-size: 11px;\n  color: var(--text);\n  font-family: inherit;\n  box-sizing: border-box;\n}\r\n\r\n.add-units-input:focus {\n  outline: none;\n  border-color: var(--warning);\n  box-shadow: 0 0 0 2px rgba(183, 121, 31, 0.18);\n}\r\n\r\n.add-units-input:disabled { opacity: 0.5; cursor: not-allowed; }\r\n\r\n/* ── ReceiptWizard ────────────────────────────────────────────────────────── */\r\n\r\n/* BrandAvatar */\r\n\r\n.brand-avatar {\n  width: 52px; height: 52px; border-radius: 10px; overflow: hidden; flex-shrink: 0;\n  display: flex; align-items: center; justify-content: center;\n}\r\n\r\n.brand-avatar--img          { background: var(--bg-surface, #fff); border: 1px solid var(--border); }\r\n\r\n.brand-avatar--fallback     { background: var(--bg-muted); border: none; }\r\n\r\n.brand-avatar--fallback-sel { background: var(--primary); border: none; }\r\n\r\n.brand-avatar__img  { width: 100%; height: 100%; object-fit: contain; padding: 6px; }\r\n\r\n.brand-avatar__initial { font-size: 22px; font-weight: 800; line-height: 1; }\r\n\r\n.brand-avatar__initial--default  { color: var(--primary); }\r\n\r\n.brand-avatar__initial--selected { color: #fff; }\r\n\r\n/* Warehouse filter row */\r\n\r\n.wizard-wh-filter-row { display: flex; gap: 8px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }\r\n\r\n.wizard-wh-filter-label { font-size: 12px; font-weight: 600; color: var(--text-subtle); flex-shrink: 0; }\r\n\r\n.wizard-wh-btn { min-height: 32px; padding: 4px 12px; font-size: 12px; }\r\n\r\n.wizard-wh-badge {\n  font-size: 12px; font-weight: 700; padding: 3px 10px;\n  border-radius: 999px; background: var(--bg-primary-soft);\n  color: var(--primary); border: 1px solid var(--primary);\n}\r\n\r\n/* Order filter row */\r\n\r\n.wizard-filter-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }\r\n\r\n.wizard-filter-btn { min-height: 36px; padding: 6px 14px; font-size: 13px; }\r\n\r\n.wizard-date-input { flex: 1 1 150px; min-width: 140px; }\r\n\r\n/* Order card inner elements */\r\n\r\n.wizard-order-card__info-wrap { display: flex; align-items: flex-start; gap: 10px; flex: 1; min-width: 0; }\r\n\r\n.wizard-order-card__item-name { font-size: 13px; line-height: 1.3; }\r\n\r\n.wizard-order-card__item-code { font-size: 11px; color: var(--text-subtle); }\r\n\r\n.wizard-order-card__status {\n  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;\n  padding: 2px 7px; border-radius: 999px; flex-shrink: 0; align-self: flex-start;\n}\r\n\r\n.wizard-order-card__status--released { background: var(--bg-success-soft); color: var(--success); }\r\n\r\n.wizard-order-card__status--pending  { background: var(--bg-muted); color: var(--text-subtle); }\r\n\r\n/* card-panel size modifiers */\r\n\r\n.card-panel--narrow { max-width: 520px; margin-left: auto; margin-right: auto; }\r\n\r\n.card-panel--lg     { max-width: 640px; margin-left: auto; margin-right: auto; }\r\n\r\n/* detail-item / details-grid size modifiers */\r\n\r\n.detail-item--sm          { gap: 2px; }\r\n\r\n.detail-item__label--xs   { font-size: 10px; }\r\n\r\n.detail-item__label--sm   { font-size: 11px; }\r\n\r\n.detail-item__value--sm   { font-size: 13px; }\r\n\r\n.detail-item__value--md   { font-size: 14px; }\r\n\r\n.details-grid--sm         { gap: 6px; }\r\n\r\n/* qty-display-card content */\r\n\r\n.qty-display-card__value         { font-size: 64px; font-weight: 800; color: var(--primary); line-height: 1; }\r\n\r\n.qty-display-card__label         { font-size: 13px; color: var(--text-subtle); margin-top: 6px; }\r\n\r\n.qty-display-card__value--batch  { font-size: 52px; font-weight: 800; color: var(--primary); line-height: 1; }\r\n\r\n.qty-display-card__label--batch  { font-size: 12px; color: var(--text-subtle); margin-top: 4px; }\r\n\r\n/* Large number input */\r\n\r\n.input-large-number { font-size: 18px; font-weight: 700; text-align: center; }\r\n\r\n.hint--danger { color: var(--danger); }\r\n\r\n/* UOM section */\r\n\r\n.section-microlabel {\n  font-size: 11px; font-weight: 700; color: var(--text-subtle);\n  text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px;\n  display: block;\n}\r\n\r\n.uom-chips-wrap { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }\r\n\r\n.uom-empty-text { font-size: 12px; color: var(--text-subtle); }\r\n\r\n.uom-summary-box {\n  margin-top: 8px; padding: 8px 12px;\n  background: var(--bg-soft); border-radius: 8px;\n  font-size: 12px; color: var(--text-subtle);\n}\r\n\r\n.uom-summary-box__note { margin-top: 2px; opacity: 0.7; }\r\n\r\n.uom-required-warning { color: var(--danger); font-size: 12px; margin-bottom: 12px; }\r\n\r\n/* Wizard nav rows */\r\n\r\n.wizard-nav-row    { display: flex; gap: 8px; margin-top: 16px; }\r\n\r\n.wizard-nav-btn--sm { min-height: 44px; }\r\n\r\n.wizard-nav-btn    { min-height: 48px; }\r\n\r\n.wizard-nav-btn--lg { min-height: 52px; }\r\n\r\n/* Batch card elements */\r\n\r\n.batch-card__copy-label { font-size: 10px; color: var(--text-subtle); font-style: italic; }\r\n\r\n.batch-card__actions    { display: flex; gap: 6px; flex-shrink: 0; }\r\n\r\n.batch-card__action-btn { padding: 4px 10px; font-size: 12px; min-height: 28px; }\r\n\r\n.batch-card__remove-btn {\n  font-size: 12px; padding: 4px 10px; min-height: 28px;\n  color: var(--danger); align-self: flex-start;\n}\r\n\r\n/* Batch number display */\r\n\r\n.batch-number-display {\n  display: flex; align-items: center; gap: 10px;\n  padding: 11px 14px; background: var(--bg-muted);\n  border: 1px solid var(--border); border-radius: 8px;\n  font-size: 16px; font-weight: 700; font-family: monospace;\n  color: var(--text); letter-spacing: .03em;\n  user-select: all; cursor: default;\n}\r\n\r\n.batch-number-display__lock { font-size: 14px; opacity: 0.5; }\r\n\r\n.batch-number-display__auto {\n  font-size: 13px; font-family: inherit; font-weight: 500;\n  color: var(--text-muted); font-style: italic;\n}\r\n\r\n/* Step 2 bin */\r\n\r\n.wizard-bin-wrap    { display: flex; flex-direction: column; gap: 10px; }\r\n\r\n.wizard-section-label { font-weight: 600; font-size: 14px; color: var(--text); }\r\n\r\n/* Step 3 dates */\r\n\r\n.wizard-dates-grid { display: grid; gap: 12px; }\r\n\r\n.app-input--readonly { pointer-events: none; background: var(--bg-muted); color: var(--text-muted); cursor: default; }\r\n\r\n/* Step 4 attribute banners */\r\n\r\n.attr-loading-banner {\n  display: flex; align-items: center; gap: 8px; padding: 10px 12px;\n  margin-bottom: 12px; border-radius: 8px;\n  background: var(--bg-muted); border: 1px solid var(--border);\n  font-size: 13px; color: var(--text-muted);\n}\r\n\r\n.attr-loading-banner__icon { font-size: 16px; }\r\n\r\n.attr-error-banner {\n  padding: 9px 12px; margin-bottom: 12px; border-radius: 8px;\n  background: var(--bg-warning-soft); border: 1px solid rgba(183, 121, 31, 0.35);\n  font-size: 12px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\n}\r\n\r\n.attr-error-banner__icon { color: var(--warning); font-weight: 600; }\r\n\r\n.attr-error-banner__text { color: var(--text-muted); flex: 1; }\r\n\r\n.attr-retry-btn {\n  padding: 3px 10px; border-radius: 6px;\n  background: transparent; color: var(--warning); border: 1px solid var(--warning);\n  font-size: 11px; cursor: pointer; font-weight: 600; white-space: nowrap;\n}\r\n\r\n/* Attribute stepper */\r\n\r\n.attr-stepper-scroll { overflow-x: auto; margin-bottom: 16px; padding-bottom: 4px; }\r\n\r\n.attr-stepper-row    { display: flex; align-items: flex-start; min-width: max-content; gap: 0; }\r\n\r\n.attr-stepper-btn {\n  display: flex; flex-direction: column; align-items: center;\n  gap: 4px; padding: 2px 5px; border: none; background: none;\n  transition: opacity 0.15s;\n}\r\n\r\n.attr-stepper-circle {\n  width: 24px; height: 24px; border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 10px; font-weight: 700; flex-shrink: 0;\n  transition: background 0.15s, border-color 0.15s;\n}\r\n\r\n.attr-stepper-label { font-size: 9px; white-space: nowrap; }\r\n\r\n.attr-connector { width: 14px; height: 1.5px; align-self: flex-start; margin-top: 13px; flex-shrink: 0; }\r\n\r\n/* Mobile current-attribute indicator — hidden by default, shown only on mobile */\r\n\r\n.attr-mobile-current { display: none; }\r\n\r\n/* Attribute selected chip */\r\n\r\n.attr-selected-wrap { margin-bottom: 10px; }\r\n\r\n.attr-selected-chip {\n  display: inline-block; padding: 3px 10px; border-radius: 999px;\n  background: var(--primary); color: #fff; font-size: 12px; font-weight: 600;\n}\r\n\r\n/* Attribute option grid + empty option */\r\n\r\n.attr-options-grid { display: grid; gap: 8px; }\r\n\r\n.attr-option-empty {\n  padding: 10px 8px; border-radius: 10px; border: 2px dashed var(--border);\n  background: transparent; color: var(--text-muted);\n  cursor: pointer; font-size: 12px; font-weight: 400;\n  text-align: center; line-height: 1.3;\n  display: flex; flex-direction: column; align-items: center; gap: 4px;\n  transition: border-color 0.12s, background 0.12s;\n}\r\n\r\n.attr-option-empty--selected { background: var(--bg-muted); border-color: var(--text-muted); font-weight: 700; }\r\n\r\n.attr-option-empty__icon { font-size: 16px; line-height: 1; }\r\n\r\n.attr-option-brand-check { position: absolute; top: 5px; right: 7px; font-size: 11px; font-weight: 800; color: var(--primary); }\r\n\r\n.attr-clear-btn {\n  margin-top: 6px; padding: 3px 10px; border-radius: 6px;\n  background: none; border: 1px dashed var(--border);\n  color: var(--text-muted); font-size: 11px; cursor: pointer;\n}\r\n\r\n/* Review step */\r\n\r\n.review-batch-row { flex-wrap: wrap; gap: 8px; margin-bottom: 6px; }\r\n\r\n.result-title { font-size: 26px; line-height: 1.2; }\r\n\r\n.receipt-print-btn { min-height: 52px; font-size: 15px; }\r\n\r\n/* Wizard bottom nav */\r\n\r\n.wizard-back-wrap { text-align: center; padding: 12px 16px 24px; }\r\n\r\n.wizard-back-btn  { font-size: 12px; min-height: 36px; padding: 6px 16px; opacity: 0.75; }\r\n\r\n/* Loading state modifiers */\r\n\r\n.loading-state--mb        { margin-bottom: 16px; }\r\n\r\n.loading-state--row-start { justify-content: flex-start; padding: 4px 0 0; }\r\n\r\n.loading-primary-text     { font-size: 12px; color: var(--primary); }\r\n\r\n/* wizard-order-card cursor when loading */\r\n\r\n.wizard-order-card--dimmed { cursor: default !important; }\r\n\r\n/* ── ReceiptReviewPage grid footer ───────────────────────────────────────── */\r\n\r\n.rr-grid-footer {\n  padding: 9px 16px;\n  border-top: 2px solid var(--border);\n  background: var(--bg-elevated);\n  display: flex;\n  gap: 16px;\n  align-items: center;\n  flex-wrap: wrap;\n}\r\n\r\n.rr-grid-totals   { display: flex; gap: 12px; align-items: center; }\r\n\r\n.rr-grid-total-text { font-size: 12px; color: var(--text-muted); }\r\n\r\n.rr-grid-total-val  { color: var(--text); font-weight: 700; }\r\n\r\n.rr-grid-divider  { width: 1px; height: 20px; background: var(--border); flex-shrink: 0; }\r\n\r\n.rr-grid-sel-count { font-size: 12px; color: var(--primary); font-weight: 600; }\r\n\r\n.rr-grid-action-btn { font-size: 11px; min-height: 28px; padding: 2px 12px; white-space: nowrap; }\r\n\r\n.rr-grid-error-text { font-size: 11px; color: var(--danger); }\r\n\r\n/* ── Mobile responsive (≤ 480px) ──────────────────────────────────────────── */\r\n\r\n@media (max-width: 480px) {\n  /* 1. Root-level horizontal overflow prevention */\n  html, body, #root, .app-shell {\n    overflow-x: hidden;\n    max-width: 100vw;\n  }\n\n  .app-content {\n    width: 100%;\n    padding-inline: 12px;\n    box-sizing: border-box;\n    overflow-x: hidden;\n  }\n\n  /* 2. Page shells — clip any descendant overflow at the page edge */\n  .page-shell,\n  .page-shell--center {\n    max-width: 100%;\n    box-sizing: border-box;\n    overflow-x: hidden;\n    padding-inline: 0;\n  }\n\n  /* 3. Card panels — tighter padding + contain */\n  .card-panel {\n    padding: 16px;\n    max-width: 100%;\n    box-sizing: border-box;\n  }\n\n  .card-panel--compact,\n  .card-panel--narrow,\n  .card-panel--lg {\n    max-width: 100%;\n    box-sizing: border-box;\n  }\n\n  /* 4. Batch cards — min-width:0 is critical.\n     .batch-card has display:grid; its children get min-width:auto by default,\n     which resolves to the child's minimum content size and forces the grid\n     column (and thus the card) wider than the viewport. */\n  .batch-card,\n  .batch-card--confirmed,\n  .batch-card--active {\n    min-width: 0;\n    width: 100%;\n    max-width: 100%;\n    box-sizing: border-box;\n    overflow-x: hidden;\n    padding: 14px;\n    gap: 12px;\n  }\n\n  /* Every direct grid item inside batch-card must also have min-width:0 */\n  .batch-card > * {\n    min-width: 0;\n  }\n\n  /* 5. Main wizard step bar — touch-scroll, properly bounded */\n  .wizard-stepbar-wrap {\n    min-width: 0;\n    max-width: 100%;\n    padding: 14px 8px 20px;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  /* 6. Batch internal mini-stepper (Batch# / Qty / Bin / Dates / Attrs / Review)\n     This is the primary cause of batch-card overflow:\n     min-width:auto on the flex container resolves to 6 steps × 44px = 264px+,\n     pushing the grid column wider than the viewport. min-width:0 fixes it. */\n  .mini-wizard-wrap {\n    min-width: 0;\n    width: 100%;\n    max-width: 100%;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    padding-bottom: 6px;\n  }\n\n  /* 7. Attribute mini-stepper (Size / Brand / Category / Packing / Season…)\n     Same min-width:auto issue — its child .attr-stepper-row has min-width:max-content\n     which expands the scroll container. min-width:0 constrains it properly. */\n  .attr-stepper-scroll {\n    min-width: 0;\n    width: 100%;\n    max-width: 100%;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    padding-bottom: 6px;\n  }\n\n  /* 8. Wizard nav row — wrap buttons instead of overflowing */\n  .wizard-nav-row {\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  /* 9. Wizard dates grid — single column on narrow screens */\n  .wizard-dates-grid {\n    grid-template-columns: 1fr;\n  }\n\n  /* 10. Attribute options grid — responsive columns, never wider than container */\n  .attr-options-grid {\n    grid-template-columns: repeat(auto-fit, minmax(88px, 1fr)) !important;\n    max-width: 100%;\n    min-width: 0;\n  }\n\n  /* 10b. Mobile current-attribute indicator */\n  .attr-mobile-current {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n    padding: 10px 12px;\n    margin-bottom: 10px;\n    border-radius: 12px;\n    background: color-mix(in srgb, var(--primary) 10%, var(--bg));\n    border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);\n  }\n  .attr-mobile-current__label {\n    font-size: 10px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    color: var(--text-muted);\n  }\n  .attr-mobile-current__name {\n    font-size: 17px;\n    font-weight: 700;\n    color: var(--text);\n    line-height: 1.2;\n  }\n  .attr-mobile-current__meta {\n    font-size: 11px;\n    color: var(--text-subtle);\n    margin-top: 1px;\n  }\n  .attr-mobile-current__value {\n    font-size: 12px;\n    color: var(--primary);\n    font-weight: 600;\n    margin-top: 4px;\n  }\n\n  /* 11. Text overflow prevention for long batch/order text */\n  .batch-card__title,\n  .batch-card__index,\n  .wizard-order-card__item-name,\n  .batch-number-display,\n  .batch-number-display__auto {\n    overflow-wrap: anywhere;\n    word-break: break-word;\n    min-width: 0;\n  }\n\n  /* 12. ReceiptReviewPage — contain main shell */\n  .rr-page-shell {\n    max-width: 100%;\n    box-sizing: border-box;\n    overflow-x: hidden;\n  }\n\n  .rr-page-col {\n    max-width: 100%;\n    overflow-x: hidden;\n  }\n\n  .rr-stats-row {\n    flex-wrap: wrap;\n  }\n\n  .rr-filter-bar {\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n\n  .rr-header-first-btn,\n  .rr-header-btn {\n    font-size: 12px;\n    padding: 6px 10px;\n  }\n\n  /* 13. Users table → card layout per row */\n  .um-page-shell {\n    gap: 10px;\n  }\n\n  .um-page-header {\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .um-page-header__actions {\n    width: 100%;\n  }\n\n  .um-page-header__actions .app-button {\n    flex: 1 1 auto;\n  }\n\n  .um-stats-row {\n    grid-template-columns: 1fr;\n  }\n\n  .um-stat-card {\n    padding: 8px 10px;\n  }\n\n  .um-table-wrap {\n    overflow: visible;\n    border-radius: 8px;\n  }\n\n  .um-table-overflow {\n    overflow-x: visible;\n  }\n\n  .um-table thead {\n    display: none;\n  }\n\n  .um-table tbody tr {\n    display: flex;\n    flex-direction: column;\n    padding: 12px 14px;\n    border-bottom: 1px solid var(--border) !important;\n  }\n\n  .um-table tbody td {\n    display: block;\n    padding: 2px 0;\n    border: none;\n    font-size: 13px;\n    text-align: left;\n  }\n\n  .um-table__username {\n    font-weight: 700;\n    font-size: 14px;\n    padding-bottom: 2px;\n  }\n\n  .um-table__warehouse,\n  .um-table__date {\n    font-size: 12px;\n  }\n\n  .um-table__actions {\n    display: flex !important;\n    flex-wrap: wrap;\n    gap: 6px;\n    padding-top: 10px;\n    border-top: 1px solid var(--border);\n    margin-top: 8px;\n  }\n\n  .um-role-chips {\n    max-width: none;\n    margin-block: 4px;\n  }\n}\r\n\r\n/* ── Logo & Brand Strip ───────────────────────────────── */\r\n\r\n/* Image resets — never crop or stretch */\r\n\r\n.app-logo,\n.logo-img,\n.partner-logo {\n  display: block;\n  object-fit: contain;\n  width: auto;\n  height: auto;\n  max-width: 100%;\n  max-height: 100%;\n}\r\n\r\n/* Wrapper frames — sizing lives on the wrapper, not the <img> */\r\n\r\n.logo-frame {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: visible;\n  flex-shrink: 0;\n}\r\n\r\n.logo-frame img {\n  max-width: 100%;\n  max-height: 100%;\n  width: auto;\n  height: auto;\n  object-fit: contain;\n  display: block;\n}\r\n\r\n.logo-frame--header  { width: 172px; height: 80px; }\r\n\r\n.logo-frame--login   { width: 186px; height: 86px; }\r\n\r\n.logo-frame--partner { width: 110px; height: 52px; }\r\n\r\n.brand-strip {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 24px;\n  padding: 16px 0 4px;\n  border-top: 1px solid var(--border);\n  margin-top: 20px;\n}\r\n\r\n.login-logo-img {\n  display: flex;\n  justify-content: center;\n  margin-bottom: 16px;\n}\r\n\r\n/* Header: egast logo sits inline before eyebrow text */\r\n\r\n.app-brand {\n  display: inline-flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 12px;\n}\r\n\r\n.app-brand__text {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 4px;\n}\r\n\r\n@media (max-width: 640px) {\n  .logo-frame--header  { width: 110px; height: 50px; }\n  .logo-frame--login   { width: 148px; height: 68px; }\n  .logo-frame--partner { width: 86px;  height: 40px; }\n\n  .brand-strip {\n    gap: 16px;\n    padding: 12px 0 4px;\n  }\n}\r\n\r\n/* ── Animations ──────────────────────────────────────────────────────────── */\r\n\r\n/* Page transition — triggered by key change in PageTransition wrapper */\r\n\r\n@keyframes pageFadeIn {\n  from { opacity: 0; }\n  to   { opacity: 1; }\n}\r\n\r\n.page-transition {\n  animation: pageFadeIn 220ms ease-out backwards;\n}\r\n\r\n/* Card panel step transition — each wizard step fades in as it mounts */\r\n\r\n@keyframes cardFadeIn {\n  from { opacity: 0; transform: translateY(6px); }\n  to   { opacity: 1; transform: none; }\n}\r\n\r\n.card-panel {\n  animation: cardFadeIn 200ms ease-out backwards;\n}\r\n\r\n/* New active batch card entrance */\r\n\r\n.batch-card--active {\n  animation: cardFadeIn 180ms ease-out both;\n}\r\n\r\n/* Modal entrance — scale + fade */\r\n\r\n@keyframes modalFadeIn {\n  from { opacity: 0; transform: scale(0.97) translateY(6px); }\n  to   { opacity: 1; transform: scale(1)    translateY(0);   }\n}\r\n\r\n.modal-card {\n  animation: modalFadeIn 200ms ease-out both;\n}\r\n\r\n/* ── Reduced-motion safety net ───────────────────────────────────────────── */\r\n\r\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.001ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.001ms !important;\n    scroll-behavior: auto !important;\n  }\n  /* Spinners and active loading progress must keep animating — they convey live loading state, not decoration */\n  .loading-spinner,\n  .app-spinner__circle,\n  .cs-map__spinner,\n  .app-top-bar-progress__bar,\n  .MuiCircularProgress-root,\n  .MuiCircularProgress-svg,\n  .MuiCircularProgress-circle,\n  .skeleton-row span {\n    animation-duration: 0.85s !important;\n    animation-iteration-count: infinite !important;\n    animation-play-state: running !important;\n  }\n}\r\n\r\n/* ── RTL support (Arabic) ─────────────────────────────────────────────────── */\r\n\r\n/* Numbers in table cells stay LTR regardless of document direction */\r\n\r\n.num-ltr {\n  direction: ltr;\n  unicode-bidi: plaintext;\n}\r\n\r\n/* Arabic inputs should align right and type RTL */\r\n\r\n[dir='rtl'] input:not([type='checkbox']):not([type='radio']):not([type='date']):not([type='number']),\n[dir='rtl'] select,\n[dir='rtl'] textarea {\n  text-align: right;\n}\r\n\r\n/* Date and number inputs keep LTR direction for correct format */\r\n\r\n[dir='rtl'] input[type='date'],\n[dir='rtl'] input[type='number'] {\n  direction: ltr;\n  text-align: left;\n}\r\n\r\n/* Labels align right in RTL */\r\n\r\n[dir='rtl'] .form-label,\n[dir='rtl'] .rr-filter-label,\n[dir='rtl'] .rr-dialog__field-label {\n  text-align: right;\n}\r\n\r\n/* Feedback/info blocks — align text right */\r\n\r\n[dir='rtl'] .feedback-message,\n[dir='rtl'] .rr-user-banner {\n  text-align: right;\n}\r\n\r\n/* Toolbar: always LTR layout regardless of document direction */\r\n\r\n.app-toolbar,\n.app-toolbar__content,\n.app-toolbar__actions {\n  direction: ltr;\n  flex-direction: row;\n}\r\n\r\n/* Breadcrumb text only: auto direction so Arabic text renders RTL naturally */\r\n\r\n.breadcrumb,\n.app-brand__text {\n  direction: auto;\n  unicode-bidi: plaintext;\n}\r\n\r\n/* Step bar: reverse order so step 1 is on the right in RTL */\r\n\r\n[dir='rtl'] .step-bar {\n  flex-direction: row-reverse;\n}\r\n\r\n/* Filter bar: wrap normally in both directions */\r\n\r\n[dir='rtl'] .rr-filter-bar {\n  flex-direction: row-reverse;\n  flex-wrap: wrap;\n}\r\n\r\n/* Bulk toolbar: reverse order in RTL */\r\n\r\n[dir='rtl'] .bulk-toolbar {\n  flex-direction: row-reverse;\n}\r\n\r\n/* Col filter pills: reverse order */\r\n\r\n[dir='rtl'] .rr-col-pills {\n  flex-direction: row-reverse;\n}\r\n\r\n/* Stats row: reverse in RTL */\r\n\r\n[dir='rtl'] .rr-stats-row {\n  flex-direction: row-reverse;\n}\r\n\r\n/* Page header: keep brand left / actions right in RTL too */\r\n\r\n[dir='rtl'] .rr-page-header {\n  flex-direction: row-reverse;\n}\r\n\r\n/* Modal action rows: keep DOM order (primary button on right = reading-start in RTL) */\r\n\r\n[dir='rtl'] .rr-dialog__actions,\n[dir='rtl'] .rr-import-modal__actions,\n[dir='rtl'] .modal-btn-row {\n  flex-direction: row;\n}\r\n\r\n/* Nav card body: align text right */\r\n\r\n[dir='rtl'] .nav-card__body {\n  text-align: right;\n}\r\n\r\n/* Page header inner (icon + text): reverse order */\r\n\r\n[dir='rtl'] .page-header-inner {\n  flex-direction: row-reverse;\n  text-align: right;\n}\r\n\r\n/* Grid footer: reverse */\r\n\r\n[dir='rtl'] .rr-grid-footer {\n  flex-direction: row-reverse;\n}\r\n\r\n/* Grid scroll container: force LTR scroll direction so column order stays correct */\r\n\r\n[dir='rtl'] .rr-grid-scroll {\n  direction: ltr;\n}\r\n\r\n/* Table cells with numeric data: always LTR */\r\n\r\n[dir='rtl'] td.cell-num,\n[dir='rtl'] .rr-grid-total-val {\n  direction: ltr;\n  unicode-bidi: plaintext;\n}\r\n\r\n/* Users table: align cells to reading direction */\r\n\r\n[dir='rtl'] .um-table td {\n  text-align: right;\n}\r\n\r\n/* Users table: actions column stays centered */\r\n\r\n[dir='rtl'] .um-table td:last-child {\n  text-align: center;\n}\r\n\r\n/* Users page: modal form field labels align right */\r\n\r\n[dir='rtl'] .um-modal-form .form-field,\n[dir='rtl'] .um-modal-form .form-label {\n  text-align: right;\n}\r\n\r\n/* Users page: simple modal header (title + close button) */\r\n\r\n[dir='rtl'] .simple-modal__header {\n  flex-direction: row-reverse;\n}\r\n\r\n/* Filter dropdown: text alignment and checkbox order inside popup */\r\n\r\n[dir='rtl'] .col-filter-dropdown__search {\n  text-align: r