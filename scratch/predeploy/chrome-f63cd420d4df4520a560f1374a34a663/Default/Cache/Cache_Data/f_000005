hrink: 0;\n}\r\n\r\n.nav-card__icon--code {\n  font-size: 52px;\n  font-weight: 800;\n  letter-spacing: 0;\n}\r\n\r\n.nav-card__body {\n  display: grid;\n  gap: 8px;\n}\r\n\r\n.nav-card__title {\n  font-size: 22px;\n  font-weight: 800;\n  line-height: 1.2;\n  color: var(--text);\n}\r\n\r\n.nav-card__desc {\n  font-size: 14px;\n  color: var(--text-muted);\n  line-height: 1.6;\n  max-width: 300px;\n}\r\n\r\n/* ── Login page ─────────────────────────────────────────────────────────── */\r\n\r\n.login-shell {\n  min-height: calc(100svh - 80px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  background:\n    radial-gradient(circle at 30% 20%, rgba(37, 99, 235, 0.08), transparent 40%),\n    radial-gradient(circle at 70% 80%, rgba(22, 128, 60, 0.06), transparent 40%),\n    var(--bg);\n}\r\n\r\n.login-card {\n  background: var(--bg-elevated);\n  border-radius: 16px;\n  padding: 40px 36px;\n  width: 100%;\n  max-width: 380px;\n  box-shadow: var(--shadow-lg);\n  border: 1px solid var(--border);\n}\r\n\r\n.login-logo {\n  width: 54px;\n  height: 54px;\n  border-radius: 14px;\n  background: var(--primary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n  color: #fff;\n  margin-bottom: 18px;\n  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);\n}\r\n\r\n.login-eyebrow {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: .08em;\n  color: var(--primary);\n  margin-bottom: 6px;\n}\r\n\r\n.login-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: var(--text);\n  margin: 0 0 28px;\n  line-height: 1.2;\n}\r\n\r\n@media (max-width: 480px) {\n  .login-shell {\n    min-height: calc(100svh - 150px);\n    padding: 12px;\n  }\n\n  .login-card {\n    padding: 22px 16px;\n    border-radius: 10px;\n  }\n\n  .login-title {\n    font-size: 21px;\n    margin-bottom: 20px;\n  }\n\n  .page-title {\n    font-size: 19px;\n  }\n\n  .breadcrumb__item {\n    font-size: 12px;