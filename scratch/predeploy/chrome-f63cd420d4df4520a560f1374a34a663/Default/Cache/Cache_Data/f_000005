\n\r\n.mini-wizard-connector {\n  flex: 1;\n  height: 2px;\n  margin-top: 13px;\n  min-width: 8px;\n  border-radius: 2px;\n  background: var(--border);\n  transition: background 0.15s;\n}\r\n\r\n.mini-wizard-connector--done {\n  background: var(--success);\n}\r\n\r\n/* ── Batch card state variants ──────────────────────────────────────────── */\r\n\r\n.batch-card--active {\n  border-color: var(--primary);\n  background: var(--bg-elevated);\n  box-shadow: var(--shadow-sm);\n}\r\n\r\n.batch-card--confirmed {\n  border-color: var(--success);\n  background: var(--bg-elevated);\n  padding: 14px;\n  gap: 10px;\n}\r\n\r\n.batch-card__index--success { color: var(--success); }\r\n\r\n/* ── Quantity display card ──────────────────────────────────────────────── */\r\n\r\n.qty-display-card {\n  text-align: center;\n  padding: 20px 16px;\n  background: var(--bg-primary-soft);\n  border: 1px solid rgba(37, 99, 235, 0.15);\n  border-radius: 12px;\n  margin-bottom: 20px;\n}\r\n\r\nhtml[data-theme='dark'] .qty-display-card {\n  border-color: rgba(96, 165, 250, 0.18);\n}\r\n\r\n/* ── Step success actions ───────────────────────────────────────────────── */\r\n\r\n.receipt-action-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-top: 4px;\n}\r\n\r\n.receipt-action-row {\n  display: flex;\n  gap: 12px;\n}\r\n\r\n/* ── Product icon badge (order cards) ──────────────────────────────────── */\r\n\r\n.product-icon-badge {\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 28px;\n  background: rgba(96, 165, 250, 0.12);\n  border: 1px solid rgba(96, 165, 250, 0.3);\n  flex-shrink: 0;\n  line-height: 1;\n}\r\n\r\nhtml[data-theme='dark'] .product-icon-badge {\n  background: rgba(96, 165, 250, 0.1);\n  border-color: rgba(96, 165, 250, 0.22);\n}\r\n\r\n/* ── Toolbar user badge ─────────────────────────────────────────────────── */\r\n\r\n.user-badge {\n  display: inline-flex